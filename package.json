{
  "name": "scraper-challenge",
  "version": "1.0.0",
  "description": "A web scraping challenge using Node.js and Express",
  "main": "src/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon --ignore datos/ --ignore pdfs/ --exec tsx src/server.ts",
